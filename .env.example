# ─────────────────────────────────────────────
# BrightSteps — Environment Variables
# Copy to .env.local for development
# Set these in Vercel/Railway dashboard for production
# ─────────────────────────────────────────────

# ── App URLs ─────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# ── NextAuth ─────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-random-32-char-string

# ── Database (PostgreSQL) ────────────────────
# Examples:
#   Local Postgres: postgresql://user:password@localhost:5432/brightsteps
#   Supabase:       postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-REF].supabase.co:5432/postgres
#   Neon:           postgresql://[USER]:[PASS]@[HOST]/[DB]?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/brightsteps

# ── Google OAuth ─────────────────────────────
# Get from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Email (Resend) ───────────────────────────
# Get from https://resend.com/api-keys
# Mail provider: set ONE of these. BREVO_API_KEY wins when both are set.
BREVO_API_KEY=
RESEND_API_KEY=re_your_api_key
EMAIL_FROM="BrightSteps <noreply@brightsteps.com>"
# For NextAuth magic links (optional)
EMAIL_SERVER=smtp://username:password@smtp.resend.com:587

# ── Stripe ───────────────────────────────────
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Price IDs (create products in Stripe dashboard first)
STRIPE_PRICE_PREMIUM=price_premium_id
STRIPE_PRICE_SCHOOL_STARTER=price_school_starter_id
STRIPE_PRICE_SCHOOL_PLAN=price_school_plan_id
STRIPE_PRICE_DISTRICT=price_district_id

# ── AWS S3 / R2 (PDF storage) ────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=brightsteps-pdfs

# ── Monitoring (optional) ────────────────────
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ── Analytics (optional) ─────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ── Phase 3: Cron jobs ───────────────────────
# Secret used to authenticate cron requests
# Generate: openssl rand -base64 32
CRON_SECRET=

# ── Phase 3: Realtime (Pusher Channels) ──────
# Sign up: https://pusher.com (free tier covers 200k messages/day)
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=us2

# ── Phase 3: Google Classroom integration ────
# Required scopes:
#  - classroom.courses.readonly
#  - classroom.rosters.readonly
#  - classroom.coursework.students
#  - classroom.profile.emails
# (Re-uses GOOGLE_CLIENT_ID/SECRET from OAuth section above)

# ── Phase 5: COPPA compliance ────────────────
# COPPA uses Stripe for credit-card-based parent verification.
# The $0.50 micro-charge is created and refunded immediately as proof of consent.
# No new env vars beyond the Stripe keys you already configured above.
# Optional override:
COPPA_VERIFICATION_AMOUNT_CENTS=50
